# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional secondary AI provider fallback
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# AI_PROVIDER: Primary AI provider ("gemini" or "openai"). Defaults to "gemini"
AI_PROVIDER="gemini"

# SUPABASE_URL: Supabase instance URL (for Edge Functions / phrases)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Supabase service role key for server operations
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB connection string (Optional: if omitted, automatic resilient in-memory/file storage is used)
# e.g., mongodb://localhost:27017/gilgit_language_bridge or mongodb+srv://user:pass@cluster.mongodb.net/gilgit_bridge
MONGODB_URI="mongodb://localhost:27017/gilgit_language_bridge"

# JWT_SECRET: Secret key for signing authentication JSON Web Tokens
JWT_SECRET="gilgit_language_bridge_super_secure_jwt_secret_2026"
